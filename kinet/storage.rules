rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /Kinet/story-captions/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('text/vtt|text/plain');
    }

    match /Kinet/reel-audio/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /messages/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /Kinet/{folder}/{userId}/{allPaths=**} {
      allow read: if true;
      // All Kinet media is uploaded through the server moderation endpoint.
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read: if true;
        // Social uploads are written only by the server moderation endpoint.
        allow write: if false;
    }
  }
}
