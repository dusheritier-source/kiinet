rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true);
    }
    
    function getRequestTime() {
      return request.time;
    }

    // User profiles - users can read/write their own profile
    match /users/{userId} {
      allow read: if isOwner(userId) || isSignedIn();
      allow create: if isOwner(userId);
      // TEMPORARY DEBUG: allow authenticated users to update their profile
      // This relaxes rules for local debugging only. Revert after testing.
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Login history - users can read/write their own login history
    match /loginHistory/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Managed devices - users can read/write their own devices
    match /managedDevices/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes.removeAll([request.auth.uid]) == resource.data.get('likes', []).removeAll([request.auth.uid]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves'])
          && request.resource.data.saves.removeAll([request.auth.uid]) == resource.data.get('saves', []).removeAll([request.auth.uid]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares'])
          && request.resource.data.shares == resource.data.get('shares', 0) + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount >= 0
          && (request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
            || request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll']));
      allow delete: if false;
    }

    // Guardian links - users can read/write their own guardian links
    match /guardianLinks/{docId} {
      allow read: if isSignedIn() && resource.data.athleteUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.athleteUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Consents - users can read/write their own consents
    match /consents/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Team documents - authenticated users can read, team members can write
    match /teamDocuments/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Admin announcements - all authenticated users can read, admins can write
    match /adminAnnouncements/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Suspicious alerts - authenticated users can read, can create
    match /suspiciousAlerts/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // Ban appeals - users can read/write their own appeals
    match /banAppeals/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Shadow ban cases - authenticated users can read
    match /shadowBanCases/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Trusted reporter nominations - authenticated users can read/write their own
    match /trustedReporterNominations/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Staff permission matrix - authenticated users can read
    match /staffPermissionMatrix/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // App settings - authenticated users can read, admins can write
    match /appSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Invite codes - authenticated users can read, admins can write
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Referrals - authenticated users can read/write
    match /referrals/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // Audit logs - authenticated users can read, can create
    match /auditLogs/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // Posts - authenticated users can read, but private account posts are restricted
    match /posts/{postId} {
      function canReadPost() {
        return resource.data.userId == request.auth.uid
          || !get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('settings', {}).get('privateAccount', false)
          || (request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('followers', [])
            && request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('following', []));
      }
      allow read: if isSignedIn() && canReadPost();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.auth.uid in request.resource.data.likes)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves'])
          && request.auth.uid in request.resource.data.saves)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares'])
          && request.resource.data.shares == resource.data.get('shares', 0) + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.get('views', 0) + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'completedViews'])
          && request.resource.data.views == resource.data.get('views', 0) + 1
          && request.resource.data.completedViews == resource.data.get('completedViews', 0) + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount >= 0
          && (request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
            || request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Comments - authenticated users can read/write
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.userId == request.auth.uid));
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.userId == request.auth.uid);
    }

    // Likes - authenticated users can read/write their own likes
    match /likes/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Follows - authenticated users can read/write
    match /follows/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // Notifications - users can read/write their own notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn() && (request.resource.data.actorId == request.auth.uid || (request.resource.data.recipientId == request.auth.uid && request.resource.data.type in ['security_alert', 'account_warning', 'report']));
      allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || (resource.data.actorId == request.auth.uid && request.resource.data.recipientId == resource.data.recipientId && request.resource.data.idempotencyKey == resource.data.idempotencyKey && request.resource.data.readBy == resource.data.readBy));
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // Direct messages - access is limited to members of the linked conversation.
    match /messages/{messageId} {
      function isConversationMember(conversationId) {
        return isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
      function otherMember(conversationId) {
        let members = get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        return members[0] == request.auth.uid ? members[1] : members[0];
      }
      function otherMemberAllowsMessage(conversationId) {
        return !exists(/databases/$(database)/documents/users/$(otherMember(conversationId)))
          || !(request.auth.uid in get(/databases/$(database)/documents/users/$(otherMember(conversationId))).data.get('blockedUsers', []));
      }

      allow read: if isConversationMember(resource.data.conversationId);
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.readBy == [request.auth.uid]
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 10000
        && request.resource.data.keys().hasOnly([
          'conversationId', 'senderId', 'text', 'attachmentUrl',
          'attachmentType', 'attachmentName', 'attachmentSize', 'replyTo',
          'reactions', 'pinnedBy', 'savedBy', 'hiddenFor', 'expiresAt', 'readBy', 'createdAt'
        ])
        && (get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.get('requestStatus', 'accepted') == 'accepted'
          || get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.get('requestedBy', request.auth.uid) == request.auth.uid)
        && (get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.get('kind', 'direct') == 'group'
          || (!(otherMember(request.resource.data.conversationId) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blockedUsers', []))
            && otherMemberAllowsMessage(request.resource.data.conversationId)))
        && isConversationMember(request.resource.data.conversationId);
      // A sender can edit or delete their message; the recipient can only add a read receipt.
      allow update: if isConversationMember(resource.data.conversationId)
        && (
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'attachmentUrl', 'attachmentType', 'attachmentName', 'attachmentSize', 'deleted', 'deletedAt', 'editedAt']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.auth.uid in request.resource.data.readBy)
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'pinnedBy', 'savedBy', 'hiddenFor'])
        );
      allow delete: if false;
    }

    match /followRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.requesterId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.requesterId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    match /profileHighlights/{highlightId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /profileVisits/{visitId} {
      allow create: if isSignedIn() && request.resource.data.visitorUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.visitorUid == request.auth.uid
        && request.resource.data.targetUid == resource.data.targetUid
        && request.resource.data.visitorUid == resource.data.visitorUid;
      allow read: if isSignedIn() && resource.data.targetUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.targetUid == request.auth.uid;
    }

    // Private search history, saved searches and alert preferences.
    match /searchPreferences/{userId} {
      allow read, delete: if isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Conversations - users can read/write their own conversations
    match /conversations/{conversationId} {
      function requestedUser() {
        return request.resource.data.participantIds[0] == request.auth.uid
          ? request.resource.data.participantIds[1]
          : request.resource.data.participantIds[0];
      }
      function requestedUserCanReceive() {
        return !exists(/databases/$(database)/documents/users/$(requestedUser()))
          || (!(request.auth.uid in get(/databases/$(database)/documents/users/$(requestedUser())).data.get('blockedUsers', []))
            && get(/databases/$(database)/documents/users/$(requestedUser())).data.get('settings', {}).get('messagePrivacy', 'everyone') != 'no_one'
            && (get(/databases/$(database)/documents/users/$(requestedUser())).data.get('settings', {}).get('messagePrivacy', 'everyone') != 'following'
              || request.auth.uid in get(/databases/$(database)/documents/users/$(requestedUser())).data.get('followers', [])));
      }
      // A deterministic direct-chat lookup must be allowed to return
      // "not found" before the signed-in participant creates it.
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/conversations/$(conversationId))
        || request.auth.uid in resource.data.participantIds
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 100
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantProfiles is list
        && request.resource.data.participantProfiles.size() == request.resource.data.participantIds.size()
        && request.resource.data.unreadBy == []
        && request.resource.data.typingBy == []
        && request.resource.data.mutedBy == []
        && request.resource.data.archivedBy == []
        && request.resource.data.pinnedBy == []
        && request.resource.data.hiddenBy == []
        && request.resource.data.leftBy == []
        && request.resource.data.requestedBy == request.auth.uid
        && ((request.resource.data.kind == 'direct'
            && request.resource.data.participantIds.size() == 2
            && request.resource.data.requestStatus == 'pending'
            && request.resource.data.adminIds == []
            && !(requestedUser() in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blockedUsers', []))
            && requestedUserCanReceive())
          || (request.resource.data.kind == 'group'
            && request.resource.data.participantIds.size() >= 3
            && request.resource.data.requestStatus == 'accepted'
            && request.resource.data.adminIds == [request.auth.uid]
            && request.resource.data.createdBy == request.auth.uid))
        && request.resource.data.keys().hasOnly([
          'key', 'participantIds', 'participantProfiles', 'lastMessage',
          'lastSenderId', 'unreadBy', 'typingBy', 'mutedBy', 'archivedBy',
          'pinnedBy', 'hiddenBy', 'requestStatus', 'requestedBy', 'kind',
          'groupName', 'groupPhotoURL', 'adminIds', 'createdBy', 'leftBy', 'updatedAt'
        ]);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantProfiles == resource.data.participantProfiles
        && request.resource.data.key == resource.data.key
        && request.resource.data.unreadBy.hasOnly(resource.data.participantIds)
        && request.resource.data.typingBy.hasOnly(resource.data.participantIds)
        && request.resource.data.mutedBy.hasOnly(resource.data.participantIds)
        && request.resource.data.archivedBy.hasOnly(resource.data.participantIds)
        && request.resource.data.get('pinnedBy', []).hasOnly(resource.data.participantIds)
        && request.resource.data.get('hiddenBy', []).hasOnly(resource.data.participantIds)
        && request.resource.data.get('leftBy', []).hasOnly(resource.data.participantIds)
        && request.resource.data.get('requestStatus', 'accepted') in ['pending', 'accepted', 'declined']
        && request.resource.data.get('requestedBy', request.auth.uid) in resource.data.participantIds
        && (request.resource.data.get('requestStatus', 'accepted') == resource.data.get('requestStatus', 'accepted')
          || request.auth.uid != resource.data.get('requestedBy', request.auth.uid))
        && (request.resource.data.lastSenderId == null
          || request.resource.data.lastSenderId in resource.data.participantIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastSenderId', 'unreadBy', 'typingBy',
          'mutedBy', 'archivedBy', 'pinnedBy', 'hiddenBy', 'leftBy', 'requestStatus', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /calls/{callId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.status == 'preparing';
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.status in ['preparing', 'ringing', 'active', 'declined', 'missed', 'ended'];
      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read, create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds
          && (
            candidateCollection in ['callerCandidates', 'calleeCandidates', 'offers', 'answers']
            || candidateCollection.matches('^candidates_.*$')
          );
        allow update, delete: if false;
      }
    }

    // Teams - authenticated users can read, team owners can write
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Events - authenticated users can read/write
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bookings - users can read/write their own bookings
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Media - authenticated users can read/write
    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    // Reels - authenticated users can read/write their own reels
    match /reels/{reelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Stories - authenticated users can read, but private account stories are restricted
    match /stories/{storyId} {
      function canReadStory() {
        return resource.data.userId == request.auth.uid
          || !get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('settings', {}).get('privateAccount', false)
          || (request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('followers', [])
            && request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('following', []));
      }
      allow read: if isSignedIn() && canReadStory();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
          && request.auth.uid in request.resource.data.seenBy)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
          && request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1)
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Marketplace listings - authenticated users can read/write
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // Analytics - users can read their own analytics
    match /analytics/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Notifications settings - users can read/write their own settings
    match /notificationSettings/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    match /notificationEvents/{eventId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /notificationTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /notificationBroadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }

    // Blocked users - users can read/write their own blocked list
    match /blockedUsers/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Saved posts - users can read/write their own saved posts
    match /savedPosts/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Drafts - users can read/write their own drafts
    match /drafts/{draftId} {
      allow read: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Reports - authenticated users can create, can read their own
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Support tickets - users can read/write their own tickets
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Newsletter subscriptions - users can read/write their own subscriptions
    match /newsletterSubscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Blog posts - authenticated users can read, authors can write
    match /blogPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Media kit - users can read/write their own media kit
    match /mediaKits/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Recruiting - authenticated users can read/write
    match /recruiting/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Challenges - authenticated users can read/write
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Leaderboards - authenticated users can read
    match /leaderboards/{leaderboardId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Groups - authenticated users can read/write
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Community posts - authenticated users can read/write their own
    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Events (legacy) - authenticated users can read/write
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Notifications (legacy schema compatibility) - only the recipient can mutate.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.actorId == request.auth.uid || (request.resource.data.recipientId == request.auth.uid && request.resource.data.type in ['security_alert', 'account_warning', 'report']));
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid || (resource.data.actorId == request.auth.uid && request.resource.data.recipientId == resource.data.recipientId && request.resource.data.idempotencyKey == resource.data.idempotencyKey && request.resource.data.readBy == resource.data.readBy));
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    // Push tokens are private and can only be managed by their owner.
    match /pushDevices/{deviceId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Fallback - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
