{
  "appId": "com.kinet.app",
  "appName": "Kinet",
  "webDir": "public",
  "server": {
    "url": "https://kinett.vercel.app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": ["kinett.vercel.app", "*.supabase.co"]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0c1220",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
