# Public application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase client configuration (required)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Supabase moderated media storage (required for uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kinet-media

# Server security (required in production; generate at least 32 random bytes)
KINET_SESSION_SECRET=
CRON_SECRET=
FIREBASE_SERVICE_ACCOUNT_KEY=
# Alternatively: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY

# Optional delivery integrations
PUSH_DELIVERY_WEBHOOK_URL=
EMAIL_DIGEST_WEBHOOK_URL=

# Optional AI integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional WebRTC TURN relay

# Never enable in production
TEST_ALLOW_BYPASS=false
DISABLE_MODERATION=false
